generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AgeGroup {
  AGE_6_9
  AGE_10_13
  ADULTS
}

enum StoryCategory {
  KINDNESS
  COURAGE
  CYBERBULLYING
  FRIENDSHIP
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ClassCodeStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RenewalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FREE_TEXT
}

enum QuizKind {
  CHAPTER
  CHECKPOINT
}

enum PointsSource {
  STORY_QUIZ
  CHECKPOINT
  GAME_KINDNESS
  GAME_BASKET
  GAME_XP
  TEACHER_AWARD
  BADGE_BONUS
  OTHER
}

enum BadgeCode {
  KINDNESS_CHAMPION
  STORY_EXPLORER
  HELPING_HAND
  SPEAK_UP
  POSITIVE_LEADER
  GAME_SHOW_READY
}

enum ReportCategory {
  HURTFUL_WORDS
  CYBERBULLYING
  PHYSICAL_UNSAFE
  SOMETHING_ELSE
}

enum ReportStatus {
  NEW
  REVIEWING
  ADDRESSED
}

enum MatchMode {
  SINGLE
  ONE_V_ONE
  FIVE_V_FIVE
}

enum MatchPhase {
  QUEUED
  COUNTDOWN
  PLAYING
  FINISHED
  CANCELLED
}

enum RoundType {
  Q1_WARMUP
  Q2_DEFENSE
  Q3_HOBBY
  Q4_FINALS
}

enum PowerCode {
  MELODY
  LAB
  NATURE
  COLOR
  HARMONY
  CHECKMATE
  PRISM
  STORY
}

enum AuthCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ReadingMode {
  READ
  LISTEN
}

enum GameRoundPhase {
  INTRO
  BUZZ
  ANSWER
  VOTE
  SHOOTOUT
  COMPLETE
}

enum TicketStatus {
  WAITING
  MATCHED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id                String     @id @default(cuid())
  role              Role
  status            UserStatus
  username          String?    @unique
  email             String?    @unique
  password_hash     String?
  nickname          String?
  real_name         String?
  avatar_url        String?
  selected_hero_id  String?
  school_id         String?
  email_verified_at DateTime?
  last_login_at     DateTime?
  settings_json     Json?
  deleted_at        DateTime?
  fcm_token         String?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  school                   School?                   @relation(fields: [school_id], references: [id])
  selected_hero            Hero?                     @relation(fields: [selected_hero_id], references: [id])
  invites_sent             StaffInvite[]             @relation("StaffInvitedBy")
  classes_teaching         Class[]                   @relation("ClassTeacher")
  codes_created            ClassCode[]               @relation("ClassCodeCreator")
  renewal_requests         ClassCodeRenewalRequest[] @relation("RenewalRequester")
  renewal_resolutions      ClassCodeRenewalRequest[] @relation("RenewalResolver")
  class_creation_requests  ClassCreationRequest[]    @relation("ClassCreationRequester")
  memberships              ClassMembership[]         @relation("ClassMember")
  memberships_approved     ClassMembership[]         @relation("MembershipApprover")
  stories_created          Story[]                   @relation("StoryCreator")
  quizzes_created          Quiz[]                    @relation("QuizCreator")
  quiz_attempts            QuizAttempt[]
  reading_progress         ReadingProgress[]
  chapter_progress         ChapterProgress[]
  points_ledger            PointsLedger[]            @relation("PointsOwner")
  points_awarded           PointsLedger[]            @relation("PointsAwarder")
  student_badges           StudentBadge[]
  hero_unlocks             StudentHeroUnlock[]
  reports_filed            SafeSpaceReport[]         @relation("ReportStudent")
  reports_assigned         SafeSpaceReport[]         @relation("ReportAssignee")
  safe_space_notes         SafeSpaceNote[]
  safe_space_visits        SafeSpaceVisit[]
  game_participants        GameParticipant[]
  notifications            Notification[]
  game_packs               GameQuestionPack[]        @relation("PackCreator")
  matchmaking_tickets      MatchmakingTicket[]

  @@index([school_id, role])
  @@index([status])
}

model AuthCode {
  id         String          @id @default(cuid())
  email      String
  purpose    AuthCodePurpose
  code_hash  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
}

model StaffInvite {
  id                    String    @id @default(cuid())
  email                 String
  invited_by_id         String
  can_access_safe_space Boolean
  token_hash            String
  accepted_at           DateTime?
  expires_at            DateTime
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  invited_by User @relation("StaffInvitedBy", fields: [invited_by_id], references: [id])
}

model School {
  id           String    @id @default(cuid())
  name         String
  profile_json Json?
  deleted_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  users                    User[]
  classes                  Class[]
  stories                  Story[]
  kindness_items           KindnessCornerItem[]
  game_packs               GameQuestionPack[]
  point_rules              PointRule[]
  badges                   Badge[]
  eligibility              GameEligibilityConfig?
  reports                  SafeSpaceReport[]
  matches                  GameMatch[]
  class_creation_requests  ClassCreationRequest[]
}

model Class {
  id          String    @id @default(cuid())
  school_id   String
  name        String
  grade_label String?
  age_group   AgeGroup
  teacher_id  String?
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  school                  School                   @relation(fields: [school_id], references: [id])
  teacher                 User?                    @relation("ClassTeacher", fields: [teacher_id], references: [id])
  codes                   ClassCode[]
  renewal_requests        ClassCodeRenewalRequest[]
  memberships             ClassMembership[]
  creation_requests       ClassCreationRequest[]   @relation("ResultingClass")
  reports                 SafeSpaceReport[]
  matches                 GameMatch[]

  @@index([school_id])
  @@index([teacher_id])
}

model ClassCode {
  id            String          @id @default(cuid())
  class_id      String
  code          String          @unique
  status        ClassCodeStatus
  expires_at    DateTime?
  created_by_id String?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  class            Class                     @relation(fields: [class_id], references: [id])
  created_by       User?                     @relation("ClassCodeCreator", fields: [created_by_id], references: [id])
  memberships      ClassMembership[]
  renewal_results  ClassCodeRenewalRequest[] @relation("RenewalNewCode")
}

model ClassCodeRenewalRequest {
  id              String                @id @default(cuid())
  class_id        String
  requested_by_id String
  reason          String?
  status          RenewalRequestStatus
  resolved_by_id  String?
  new_code_id     String?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  class        Class      @relation(fields: [class_id], references: [id])
  requested_by User       @relation("RenewalRequester", fields: [requested_by_id], references: [id])
  resolved_by  User?      @relation("RenewalResolver", fields: [resolved_by_id], references: [id])
  new_code     ClassCode? @relation("RenewalNewCode", fields: [new_code_id], references: [id])
}

model ClassCreationRequest {
  id                 String                @id @default(cuid())
  school_id          String
  requested_by_id    String
  payload_json       Json
  status             RenewalRequestStatus
  resulting_class_id String?
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  school          School @relation(fields: [school_id], references: [id])
  requested_by    User   @relation("ClassCreationRequester", fields: [requested_by_id], references: [id])
  resulting_class Class? @relation("ResultingClass", fields: [resulting_class_id], references: [id])
}

model ClassMembership {
  id                 String            @id @default(cuid())
  class_id           String
  user_id            String
  status             JoinRequestStatus
  joined_via_code_id String?
  approved_by_id     String?
  approved_at        DateTime?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  class           Class      @relation(fields: [class_id], references: [id])
  user            User       @relation("ClassMember", fields: [user_id], references: [id])
  joined_via_code ClassCode? @relation(fields: [joined_via_code_id], references: [id])
  approved_by     User?      @relation("MembershipApprover", fields: [approved_by_id], references: [id])

  @@unique([class_id, user_id])
}

model Hero {
  id                       String    @id @default(cuid())
  code                     String    @unique
  display_name             String
  role_title               String?
  bullied_for              String?
  power_code               PowerCode
  power_label              String
  power_description        String
  quote                    String?
  art_url                  String?
  sort_order               Int
  unlock_stories_required  Int       @default(0)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  selected_by  User[]
  unlocks      StudentHeroUnlock[]
  participants GameParticipant[]
}

model StudentHeroUnlock {
  user_id     String
  hero_id     String
  unlocked_at DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
  hero Hero @relation(fields: [hero_id], references: [id])

  @@id([user_id, hero_id])
}

model Story {
  id                String         @id @default(cuid())
  school_id         String
  title             String
  slug              String?
  synopsis          String?
  cover_url         String?
  category          StoryCategory
  age_group         AgeGroup
  status            PublishStatus
  estimated_minutes Int?
  chapter_count     Int
  created_by_id     String?
  deleted_at        DateTime?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  school           School          @relation(fields: [school_id], references: [id])
  created_by       User?           @relation("StoryCreator", fields: [created_by_id], references: [id])
  chapters         Chapter[]
  reading_progress ReadingProgress[]
  pack_links       GamePackStory[]

  @@index([school_id, status, age_group, category])
}

model Chapter {
  id         String    @id @default(cuid())
  story_id   String
  number     Int
  title      String
  page_count Int?
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  story            Story             @relation(fields: [story_id], references: [id])
  pages            Page[]
  audio            ChapterAudio?
  quizzes          Quiz[]
  chapter_progress ChapterProgress[]
  current_readers  ReadingProgress[]

  @@unique([story_id, number])
}

model Page {
  id         String   @id @default(cuid())
  chapter_id String
  number     Int
  body_text  String?
  image_url  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  chapter Chapter @relation(fields: [chapter_id], references: [id])

  @@unique([chapter_id, number])
}

model ChapterAudio {
  id          String   @id @default(cuid())
  chapter_id  String   @unique
  audio_url   String
  duration_ms Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  chapter Chapter @relation(fields: [chapter_id], references: [id])
}

model KindnessCornerItem {
  id         String        @id @default(cuid())
  school_id  String
  title      String
  media_url  String
  media_type MediaType
  status     PublishStatus
  deleted_at DateTime?
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  school School @relation(fields: [school_id], references: [id])
}

model Quiz {
  id            String    @id @default(cuid())
  kind          QuizKind
  chapter_id    String
  title         String?
  created_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  chapter    Chapter       @relation(fields: [chapter_id], references: [id])
  created_by User?         @relation("QuizCreator", fields: [created_by_id], references: [id])
  questions  Question[]
  attempts   QuizAttempt[]
}

model Question {
  id          String       @id @default(cuid())
  quiz_id     String
  sort_order  Int
  type        QuestionType
  prompt      String
  hint        String?
  explanation String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  quiz    Quiz             @relation(fields: [quiz_id], references: [id])
  options QuestionOption[]
  answers QuizAnswer[]
}

model QuestionOption {
  id          String   @id @default(cuid())
  question_id String
  sort_order  Int
  label       String
  is_correct  Boolean
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  question Question     @relation(fields: [question_id], references: [id])
  answers  QuizAnswer[]
}

model QuizAttempt {
  id             String            @id @default(cuid())
  quiz_id        String
  user_id        String
  started_at     DateTime
  completed_at   DateTime?
  score_correct  Int
  score_total    Int
  points_awarded Int
  status         QuizAttemptStatus
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  quiz    Quiz         @relation(fields: [quiz_id], references: [id])
  user    User         @relation(fields: [user_id], references: [id])
  answers QuizAnswer[]
}

model QuizAnswer {
  id            String   @id @default(cuid())
  attempt_id    String
  question_id   String
  option_id     String?
  free_text     String?
  is_correct    Boolean?
  attempt_index Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  attempt  QuizAttempt     @relation(fields: [attempt_id], references: [id])
  question Question        @relation(fields: [question_id], references: [id])
  option   QuestionOption? @relation(fields: [option_id], references: [id])
}

model GameQuestionPack {
  id            String        @id @default(cuid())
  school_id     String
  title         String
  age_group     AgeGroup
  created_by_id String?
  status        PublishStatus
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  school     School             @relation(fields: [school_id], references: [id])
  created_by User?              @relation("PackCreator", fields: [created_by_id], references: [id])
  stories    GamePackStory[]
  questions  GamePackQuestion[]
  matches    GameMatch[]
}

model GamePackStory {
  id         String   @id @default(cuid())
  pack_id    String
  story_id   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pack  GameQuestionPack @relation(fields: [pack_id], references: [id])
  story Story            @relation(fields: [story_id], references: [id])

  @@unique([pack_id, story_id])
}

model GamePackQuestion {
  id         String       @id @default(cuid())
  pack_id    String
  round_type RoundType
  sort_order Int
  type       QuestionType
  prompt     String
  options_json Json
  meta_json  Json?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  pack   GameQuestionPack @relation(fields: [pack_id], references: [id])
  rounds GameRound[]
}

model ReadingProgress {
  id           String       @id @default(cuid())
  user_id      String
  story_id     String
  chapter_id   String?
  page_number  Int?
  percent      Int
  completed_at DateTime?
  last_mode    ReadingMode?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  user    User     @relation(fields: [user_id], references: [id])
  story   Story    @relation(fields: [story_id], references: [id])
  chapter Chapter? @relation(fields: [chapter_id], references: [id])

  @@unique([user_id, story_id])
}

model ChapterProgress {
  user_id           String
  chapter_id        String
  percent           Int
  completed_at      DateTime?
  quiz_best_percent Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user    User    @relation(fields: [user_id], references: [id])
  chapter Chapter @relation(fields: [chapter_id], references: [id])

  @@id([user_id, chapter_id])
}

model PointsLedger {
  id              String       @id @default(cuid())
  user_id         String
  source          PointsSource
  amount          Int
  kindness_amount Int
  label           String?
  ref_type        String?
  ref_id          String?
  awarded_by_id   String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  user       User  @relation("PointsOwner", fields: [user_id], references: [id])
  awarded_by User? @relation("PointsAwarder", fields: [awarded_by_id], references: [id])

  @@index([user_id, created_at])
  @@index([user_id, source])
}

model PointRule {
  id         String   @id @default(cuid())
  school_id  String
  key        String
  value_int  Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  school School @relation(fields: [school_id], references: [id])
}

model Badge {
  id           String    @id @default(cuid())
  school_id    String?
  code         BadgeCode @unique
  title        String
  description  String
  how_to_earn  String
  art_url      String?
  criteria_json Json
  deleted_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  school         School?        @relation(fields: [school_id], references: [id])
  student_badges StudentBadge[]
}

model StudentBadge {
  user_id    String
  badge_id   String
  earned_at  DateTime @default(now())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user  User  @relation(fields: [user_id], references: [id])
  badge Badge @relation(fields: [badge_id], references: [id])

  @@id([user_id, badge_id])
}

model GameEligibilityConfig {
  school_id         String   @id
  required_stories  Int      @default(2)
  required_chapters Int      @default(6)
  min_quiz_percent  Int      @default(70)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  school School @relation(fields: [school_id], references: [id])
}

model SafeSpaceReport {
  id           String         @id @default(cuid())
  public_ref   String         @unique
  school_id    String
  student_id   String
  class_id     String?
  category     ReportCategory
  body         String
  feel_safe    Boolean
  status       ReportStatus
  assignee_id  String?
  submitted_at DateTime
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  school   School             @relation(fields: [school_id], references: [id])
  student  User               @relation("ReportStudent", fields: [student_id], references: [id])
  class    Class?             @relation(fields: [class_id], references: [id])
  assignee User?              @relation("ReportAssignee", fields: [assignee_id], references: [id])
  notes    SafeSpaceNote[]

  @@index([school_id, status])
  @@index([student_id])
  @@index([assignee_id])
}

model SafeSpaceNote {
  id         String   @id @default(cuid())
  report_id  String
  author_id  String
  body       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  report SafeSpaceReport @relation(fields: [report_id], references: [id])
  author User            @relation(fields: [author_id], references: [id])
}

model SafeSpaceVisit {
  id         String   @id @default(cuid())
  user_id    String
  match_id   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user  User       @relation(fields: [user_id], references: [id])
  match GameMatch? @relation(fields: [match_id], references: [id])
}

model GameMatch {
  id             String      @id @default(cuid())
  school_id      String
  mode           MatchMode
  phase          MatchPhase
  pack_id        String?
  class_id       String?
  started_at     DateTime?
  finished_at    DateTime?
  winner_team_id String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  school      School            @relation(fields: [school_id], references: [id])
  pack        GameQuestionPack? @relation(fields: [pack_id], references: [id])
  class       Class?            @relation(fields: [class_id], references: [id])
  winner_team GameTeam?         @relation("MatchWinner", fields: [winner_team_id], references: [id])
  teams       GameTeam[]        @relation("MatchTeams")
  participants GameParticipant[]
  rounds      GameRound[]
  visits      SafeSpaceVisit[]
}

model GameTeam {
  id              String   @id @default(cuid())
  match_id        String
  label           String
  score_xp        Int
  score_kindness  Int
  score_baskets   Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  match         GameMatch         @relation("MatchTeams", fields: [match_id], references: [id])
  won_matches   GameMatch[]       @relation("MatchWinner")
  participants  GameParticipant[]
}

model GameParticipant {
  id             String    @id @default(cuid())
  match_id       String
  team_id        String
  user_id        String?
  is_bot         Boolean   @default(false)
  jersey_number  Int?
  hero_id        String?
  is_connected   Boolean
  left_at        DateTime?
  power_used     Boolean
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  match       GameMatch   @relation(fields: [match_id], references: [id])
  team        GameTeam    @relation(fields: [team_id], references: [id])
  user        User?       @relation(fields: [user_id], references: [id])
  hero        Hero?       @relation(fields: [hero_id], references: [id])
  buzz_wins   GameRound[] @relation("BuzzWinner")
  answers     GameAnswer[]
  shootouts   GameShootout[]

  @@unique([match_id, user_id])
}

model GameRound {
  id              String         @id @default(cuid())
  match_id        String
  round_type      RoundType
  number          Int
  question_id     String?
  phase           GameRoundPhase
  deadline_at     DateTime?
  buzz_winner_id  String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  match       GameMatch          @relation(fields: [match_id], references: [id])
  question    GamePackQuestion?  @relation(fields: [question_id], references: [id])
  buzz_winner GameParticipant?   @relation("BuzzWinner", fields: [buzz_winner_id], references: [id])
  answers     GameAnswer[]
  shootouts   GameShootout[]
}

model GameAnswer {
  id                  String    @id @default(cuid())
  round_id            String
  participant_id      String
  option_index        Int?
  free_text           String?
  is_correct          Boolean?
  voted_option_index  Int?
  submitted_at        DateTime
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  round       GameRound       @relation(fields: [round_id], references: [id])
  participant GameParticipant @relation(fields: [participant_id], references: [id])
}

model GameShootout {
  id                     String   @id @default(cuid())
  round_id               String
  shooter_participant_id String
  made                   Boolean
  xp_awarded             Int
  multiplier             Int?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  round   GameRound       @relation(fields: [round_id], references: [id])
  shooter GameParticipant @relation(fields: [shooter_participant_id], references: [id])
}

model MatchmakingTicket {
  id         String       @id @default(cuid())
  user_id    String
  mode       MatchMode
  status     TicketStatus
  match_id   String?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

model Notification {
  id         String    @id @default(cuid())
  user_id    String
  type       String
  title      String
  body       String?
  data_json  Json?
  read_at    DateTime?
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id])
}
