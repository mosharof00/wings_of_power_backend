APP_NAME=Wings of Power
APP_KEY=secret
PORT=6001
APP_URL=http://localhost:6001

CLIENT_APP_URL=http://localhost:3000
SESSION_SECRET=secret
JWT_SECRET=secret
# Seconds. jsonwebtoken treats a numeric expiry as seconds. 86400 = 1 day.
JWT_EXPIRY=86400

DATABASE_URL="postgresql://postgres:root@localhost:5432/wings_of_power"

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=name@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=name@gmail.com
MAIL_FROM_NAME=Wings of Power

AWS_ACCESS_KEY_ID=
