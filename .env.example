APP_NAME=Wings of Power
APP_KEY=secret
PORT=6001
APP_URL=http://localhost:6001

CLIENT_APP_URL=http://localhost:3000
SESSION_SECRET=secret
JWT_SECRET=secret
# Seconds. jsonwebtoken treats a numeric expiry as seconds. 86400 = 1 day.
JWT_EXPIRY=86400

DATABASE_URL="postgresql://postgres:root@localhost:5432/wings_of_power"

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

# Gmail SMTP for local/dev: use a dedicated mailbox + Google App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# Never commit real credentials; put them only in gitignored `.env`.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-dev@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=your-dev@gmail.com
MAIL_FROM_NAME=Wings of Power

# File uploads: local (default) writes under public/storage/{purpose}/…
# Switch to s3 for production object storage without code changes.
FILESYSTEM_DISK=local
# When FILESYSTEM_DISK=s3, fill AWS_* below. Set AWS_FORCE_PATH_STYLE=true for MinIO.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=https://s3.us-east-2.amazonaws.com
AWS_FORCE_PATH_STYLE=false

GCP_PROJECT_ID=
GCP_KEY_FILE=
GCP_API_ENDPOINT=
GCP_BUCKET=

# -----------------------------------------------------------------------------
# Dev seed logins (local / demo only — not production secrets)
# Applied by: yarn cmd seed   (see src/command/seed.data.ts)
# Copy this file to `.env` (gitignored). Re-seed after changing passwords.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@demo.school
SEED_ADMIN_PASSWORD=change-me
SEED_TEACHER_EMAIL=teacher@demo.school
SEED_TEACHER_PASSWORD=change-me
SEED_STUDENT_PASSWORD=change-me

# Seed usernames / class code are fixed in seed.data.ts (not env vars):
#   Admin login:    admin@demo.school / change-me
#   Teacher login:  teacher@demo.school / change-me
#   Student login:  student.active / change-me
#   Class code:     864320
#   Pending user:   student.pending (no password until approved)
